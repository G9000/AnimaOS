{
  "name": "animaOS",
  "version": "0.0.0",
  "packageManager": "bun@1.4.3",
  "license": "MIT",
  "scripts": {
    "affected:build": "bun x nx affected -t build",
    "affected:test": "bun x nx affected -t test",
    "build": "bun x nx run-many -t build",
    "build:cli-sdk": "tsc -b packages/sdk/tsconfig.lib.json packages/cli/tsconfig.lib.json",
    "daemon": "bun tools/workspace-dev/src/rust-daemon-dev.ts",
    "dev": "bun x nx run workspace-dev:dev --",
    "animaos": "node packages/cli/dist/index.js",
    "graph": "bun x nx graph",
    "lint": "oxlint --config .oxlintrc.json packages/*/src apps/*/src",
    "lint:fix": "oxlint --fix --config .oxlintrc.json packages/*/src apps/*/src",
    "projects": "bun x nx show projects",
    "rust:cache:status": "bun tools/workspace-dev/scripts/rust-cache.ts status",
    "rust:cache:clean": "bun tools/workspace-dev/scripts/rust-cache.ts clean",
    "test": "bun x nx run-many -t test",
    "typecheck": "bun x nx run-many -t typecheck",
    "web": "bun x nx dev @animaos/web",
    "playground": "bun x nx dev @animaos/playground"
  },
  "private": true,
  "dependencies": {
    "playwright-core": "1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@nx/devkit": "~23.2.1",
    "@nx/esbuild": "~23.2.1",
    "@nx/js": "~23.2.1",
    "@nx/node": "~23.2.1",
    "@nx/playwright": "~23.2.1",
    "@nx/react": "~23.2.1",
    "@nx/vite": "~23.2.1",
    "@nx/vitest": "~23.2.1",
    "@nx/web": "~23.2.1",
    "@playwright/test": "^1.64.1",
    "@swc-node/register": "1.11.1",
    "@swc/core": "^1.15.32",
    "@swc/helpers": "^0.5.21",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "esbuild": "^0.28.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.1.1",
    "nx": "~23.2.1",
    "oxlint": "^1.62.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "tslib": "^2.3.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ]
}
