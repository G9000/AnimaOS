{
  "name": "animaOS",
  "version": "0.0.0",
  "packageManager": "bun@1.4.3",
  "license": "MIT",
  "scripts": {
    "dev": "bun tools/workspace-dev/src/main.ts",
    "dev:docs": "bun tools/workspace-dev/src/main.ts --docs",
    "dev:game": "bun tools/workspace-dev/src/main.ts --game",
    "dev:playground": "bun tools/workspace-dev/src/main.ts --playground",
    "dev:all": "bun tools/workspace-dev/src/main.ts --all",
    "build": "bun run --sequential --workspaces --if-present build",
    "build:libs": "tsc --build packages/sdk/tsconfig.lib.json packages/tui/tsconfig.lib.json packages/cli/tsconfig.lib.json",
    "build:cli-sdk": "bun run --filter @animaos/sdk --filter @animaos/tui --filter @animaos/cli build",
    "test": "bun run --sequential --workspaces --if-present test",
    "typecheck": "tsc --build --emitDeclarationOnly",
    "lint": "bun run --workspaces --if-present lint",
    "lint:fix": "oxlint --fix --config .oxlintrc.json packages/*/src apps/*/src tools/workspace-dev/src",
    "daemon": "bun run --filter rust-daemon dev",
    "rust:build": "cargo build --workspace",
    "rust:test": "bun run --sequential --filter rust-daemon --filter anima test",
    "browser:setup": "node tools/browser/setup.mjs",
    "rust:lint": "cargo fmt --all --check && bun run rust:clippy",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D clippy::correctness",
    "rust:cache:status": "bun tools/workspace-dev/scripts/rust-cache.ts status",
    "rust:cache:clean": "bun tools/workspace-dev/scripts/rust-cache.ts clean",
    "web": "bun run --filter @animaos/web dev",
    "playground": "bun run --filter @animaos/playground dev",
    "animaos": "node packages/cli/dist/index.js"
  },
  "private": true,
  "dependencies": {
    "playwright-core": "1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@playwright/test": "^1.64.1",
    "@swc-node/register": "1.12.1",
    "@swc/core": "^1.16.18",
    "@swc/helpers": "^0.5.23",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "esbuild": "^0.28.2",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*",
    "hosts/*"
  ]
}
