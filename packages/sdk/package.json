{
  "name": "@animaos/sdk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@animaos/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "scripts": {
    "build": "tsc --build tsconfig.lib.json",
    "typecheck": "bun run build && tsc --build --emitDeclarationOnly",
    "test": "bun ../../tools/workspace-dev/scripts/run-vitest.ts run",
    "lint": "oxlint src --config ../../.oxlintrc.json --tsconfig tsconfig.json"
  }
}
