{
  "name": "@animaos/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun run build-deps && vite",
    "build": "bun run build-deps && vite build",
    "preview": "vite preview",
    "build-deps": "bun run --filter @animaos/sdk build",
    "typecheck": "tsc --build --emitDeclarationOnly",
    "test": "bun run build-deps && bun ../../tools/workspace-dev/scripts/run-vitest.ts run",
    "lint": "oxlint src --config ../../.oxlintrc.json --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@animaos/sdk": "workspace:*",
    "@animaos/ui": "workspace:*",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "prism-react-renderer": "^2.4.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8"
  }
}
