{
  "name": "@animaos/web-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "deployment-contracts": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": ".",
          "command": "bun test deploy/vps/contracts.test.ts"
        },
        "cache": false
      },
      "e2e-console": {
        "executor": "nx:run-commands",
        "dependsOn": [
          {
            "projects": [
              "@animaos/sdk",
              "@animaos/web"
            ],
            "target": "build"
          }
        ],
        "options": {
          "cwd": "apps/web-e2e",
          "command": "playwright test --config=playwright.console.config.ts"
        },
        "parallelism": false,
        "cache": false,
        "inputs": [
          "default",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/test-output/console"
        ]
      }
    },
    "implicitDependencies": [
      "@animaos/web"
    ]
  },
  "devDependencies": {
    "@animaos/sdk": "workspace:*"
  }
}
