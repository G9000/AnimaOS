{
  "name": "@animaos/landing",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/landing/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/landing",
        "command": "astro build"
      },
      "outputs": ["{projectRoot}/dist", "{projectRoot}/.vercel/output"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/landing",
        "command": "astro dev"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/landing",
        "command": "astro preview"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/landing",
        "command": "vitest run"
      }
    }
  }
}
